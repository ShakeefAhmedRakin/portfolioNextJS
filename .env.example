# Base URL of the deployed site, with no trailing slash (e.g. https://example.com).
# Used to build canonical URLs, Open Graph/Twitter URLs, sitemap.xml, robots.txt,
# and every JSON-LD @id/url field. If unset, it falls back to http://localhost:3000
# in metadata/site-url helpers — the build will still succeed, but the site's
# canonical/OG/sitemap/JSON-LD URLs will point at localhost instead of the real
# domain, which will break search engine indexing and social share previews.
WEBSITE_URL=https://example.com

# Google Search Console site-verification token (the "content" value from the
# HTML tag verification method, not the full <meta> tag). Optional — when unset,
# no verification meta tag is rendered and Search Console verification via this
# method is simply skipped.
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (starts with "G-"). Optional — when unset,
# the GA4 script is not injected at all (see components/analytics/google-analytics.tsx).
NEXT_PUBLIC_GA_ID=

# Set to "development" to render the Vercel Toolbar in the root layout. Optional —
# when unset (or any other value), the toolbar is simply not rendered.
ENVIRONMENT=
